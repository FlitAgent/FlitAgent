			"4xl": { "$type": "number", "$value": 1.05 }
		},
		"letter-spacing": {
			"4xl": { "$type": "dimension", "$value": "-0.02em" }
		},
		"space": {
			"1": { "$type": "dimension", "$value": "4px" },
			"2": { "$type": "dimension", "$value": "8px" },

{
	"primitive": {
		"color": {
			"neutral-0": { "$type": "color", "$value": "#ffffff" },
			"neutral-25": { "$type": "color", "$value": "#fafafa" },
			"neutral-50": { "$type": "color", "$value": "#f4f4f5" },
			"neutral-100": { "$type": "color", "$value": "#e9e9eb" },
			"neutral-200": { "$type": "color", "$value": "#e4e4e7" },
			"neutral-300": { "$type": "color", "$value": "#d4d4d8" },
			"neutral-350": { "$type": "color", "$value": "#a1a1aa", "$description": "Exists so dark fg-subtle passes 4.5:1 on dark surface." },
			"neutral-400": { "$type": "color", "$value": "#8c8c94", "$description": "Lightened so border-strong passes 3:1." },
			"neutral-500": { "$type": "color", "$value": "#71717a" },
			"neutral-600": { "$type": "color", "$value": "#52525b" },
			"neutral-700": { "$type": "color", "$value": "#3f3f46" },
			"neutral-800": { "$type": "color", "$value": "#27272a" },
			"neutral-900": { "$type": "color", "$value": "#18181b" },
			"neutral-925": { "$type": "color", "$value": "#131316", "$description": "Dark surface-sunken: between bg and surface so code and diffs show on the page." },
			"neutral-950": { "$type": "color", "$value": "#0e0e10" },
			"accent-50": { "$type": "color", "$value": "#effaf8" },
			"accent-300": { "$type": "color", "$value": "#5eead4" },
			"accent-400": { "$type": "color", "$value": "#2dd4bf" },
			"accent-700": { "$type": "color", "$value": "#0d6b61" },
			"accent-800": { "$type": "color", "$value": "#0e554e" },
			"accent-950": { "$type": "color", "$value": "#0f2a27", "$description": "Dark accent-tint: a custom deep teal, not a lightened one." },
			"warm-canvas": { "$type": "color", "$value": "#f5f2e8", "$description": "Warm page canvas." },
			"warm-paper": { "$type": "color", "$value": "#fcfbf6", "$description": "Paper: cards, tables, menus." },
			"warm-sunken": { "$type": "color", "$value": "#f2efe4", "$description": "Code, diff, table header." },
			"warm-hover": { "$type": "color", "$value": "#ebe7d8", "$description": "Hovered rows and loading skeletons." },
			"warm-ink": { "$type": "color", "$value": "#1c1f1c", "$description": "Ink text." },
			"warm-ink-muted": { "$type": "color", "$value": "#5c5f58" },
			"warm-ink-subtle": { "$type": "color", "$value": "#6b6e66", "$description": "Meta text; 4.63:1 on canvas." },
			"warm-ink-faint": { "$type": "color", "$value": "#8a8c84", "$description": "Borders of inputs and decoration, 3:1 only." },
			"warm-border": { "$type": "color", "$value": "#e4dfcf", "$description": "Hairline, decorative." },
			"warm-border-raised": { "$type": "color", "$value": "#ddd8c6", "$description": "Outline of menus and modals." },
			"warm-teal-hover": { "$type": "color", "$value": "#0b443e", "$description": "Hover of the teal accent." },
			"warm-teal-tint": { "$type": "color", "$value": "#e3ece7", "$description": "Selected rows." }
		}
	},
	"semantic": {
		"color": {
			"bg": { "$type": "color", "$value": { "light": "{primitive.color.warm-canvas}", "dark": "{primitive.color.neutral-950}" }, "$description": "Page." },
			"surface": { "$type": "color", "$value": { "light": "{primitive.color.warm-paper}", "dark": "{primitive.color.neutral-900}" }, "$description": "Cards, tables." },
			"surface-raised": { "$type": "color", "$value": { "light": "{primitive.color.warm-paper}", "dark": "{primitive.color.neutral-800}" }, "$description": "Menus, modals." },
			"surface-sunken": { "$type": "color", "$value": { "light": "{primitive.color.warm-sunken}", "dark": "{primitive.color.neutral-925}" }, "$description": "Code, diff, table header." },
			"surface-hover": { "$type": "color", "$value": { "light": "{primitive.color.warm-hover}", "dark": "{primitive.color.neutral-700}" }, "$description": "Hovered rows and loading skeletons, on surface and on surface-raised." },
			"fg": { "$type": "color", "$value": { "light": "{primitive.color.warm-ink}", "dark": "{primitive.color.neutral-25}" } },
			"fg-muted": { "$type": "color", "$value": { "light": "{primitive.color.warm-ink-muted}", "dark": "{primitive.color.neutral-300}" } },
			"fg-subtle": { "$type": "color", "$value": { "light": "{primitive.color.warm-ink-subtle}", "dark": "{primitive.color.neutral-350}" }, "$description": "Meta text; only on bg and surface." },
			"border": { "$type": "color", "$value": { "light": "{primitive.color.warm-border}", "dark": "{primitive.color.neutral-800}" }, "$description": "Hairline, decorative." },
			"border-raised": { "$type": "color", "$value": { "light": "{primitive.color.warm-border-raised}", "dark": "{primitive.color.neutral-700}" }, "$description": "Outline of menus and modals on surface-raised." },
			"border-strong": { "$type": "color", "$value": { "light": "{primitive.color.warm-ink-faint}", "dark": "{primitive.color.neutral-500}" }, "$description": "Input borders." },
			"accent": { "$type": "color", "$value": { "light": "{primitive.color.accent-800}", "dark": "{primitive.color.accent-400}" }, "$description": "Primary button." },
			"accent-hover": { "$type": "color", "$value": { "light": "{primitive.color.warm-teal-hover}", "dark": "{primitive.color.accent-300}" } },
			"accent-fg": { "$type": "color", "$value": { "light": "{primitive.color.warm-paper}", "dark": "{primitive.color.neutral-950}" } },
			"accent-tint": { "$type": "color", "$value": { "light": "{primitive.color.warm-teal-tint}", "dark": "{primitive.color.accent-950}" }, "$description": "Selected rows." },
			"link": { "$type": "color", "$value": { "light": "{primitive.color.accent-800}", "dark": "{primitive.color.accent-300}" } },
			"focus": { "$type": "color", "$value": { "light": "{primitive.color.accent-800}", "dark": "{primitive.color.accent-300}" } },
			"info-fg": { "$type": "color", "$value": { "light": "#135e96", "dark": "#72aee6" } },
			"info-bg": { "$type": "color", "$value": { "light": "#f0f6fc", "dark": "#0f2438" } },
			"info-icon": { "$type": "color", "$value": { "light": "#2271b1", "dark": "#72aee6" } },
			"success-fg": { "$type": "color", "$value": { "light": "#007017", "dark": "#68de7c" } },
			"success-bg": { "$type": "color", "$value": { "light": "#edfaef", "dark": "#0d2914" } },
			"success-icon": { "$type": "color", "$value": { "light": "#00a32a", "dark": "#68de7c" } },
			"warning-fg": { "$type": "color", "$value": { "light": "#946300", "dark": "#f0c33c" } },
			"warning-bg": { "$type": "color", "$value": { "light": "#fcf9e8", "dark": "#2b2205" } },
			"warning-icon": { "$type": "color", "$value": { "light": "#dba617", "dark": "#f0c33c" } },
			"danger-fg": { "$type": "color", "$value": { "light": "#b32d2e", "dark": "#ff8085" } },
			"danger-bg": { "$type": "color", "$value": { "light": "#fcf0f1", "dark": "#3a1517" } },
			"danger-icon": { "$type": "color", "$value": { "light": "#d63638", "dark": "#ff8085" } },
			"reverted-fg": { "$type": "color", "$value": { "light": "#5b21b6", "dark": "#c4b5fd" } },
			"reverted-bg": { "$type": "color", "$value": { "light": "#f5f3ff", "dark": "#241a3f" } },
			"reverted-icon": { "$type": "color", "$value": { "light": "#7c3aed", "dark": "#c4b5fd" }, "$description": "Keeps the 4px bar visible on reverted-bg." },

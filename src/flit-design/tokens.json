			"20": { "$type": "dimension", "$value": "80px" },
			"24": { "$type": "dimension", "$value": "96px" }
		},
		"radius": {
			"sm": { "$type": "dimension", "$value": "4px", "$description": "Inputs, buttons, code." },
			"md": { "$type": "dimension", "$value": "8px", "$description": "Cards, notices, diffs." },
			"lg": { "$type": "dimension", "$value": "12px", "$description": "Marketing panels, modals." },
			"xl": { "$type": "dimension", "$value": "18px", "$description": "Cards and receipts." },
			"full": { "$type": "dimension", "$value": "999px", "$description": "Pills: buttons, inputs, chips." }
		},
		"border-width": {
			"hairline": { "$type": "dimension", "$value": "1px" },
			"focus": { "$type": "dimension", "$value": "2px" },
			"notice-bar": { "$type": "dimension", "$value": "4px" }
		},
		"shadow": {
			"card": { "$type": "shadow", "$value": { "light": "0 1px 0 rgb(28 31 28 / 0.08), 0 12px 32px -18px rgb(28 31 28 / 0.18)", "dark": "0 1px 0 rgb(0 0 0 / 0.4), 0 12px 32px -18px rgb(0 0 0 / 0.5)" }, "$description": "Cards and receipts: a hairline and a soft drop." },
			"button": { "$type": "shadow", "$value": { "light": "inset 0 1px 0 rgb(252 251 246 / 0.18), 0 10px 22px -12px rgb(14 85 78 / 0.8)", "dark": "inset 0 1px 0 rgb(255 255 255 / 0.12), 0 10px 22px -12px rgb(0 0 0 / 0.6)" }, "$description": "Primary button lift: a paper highlight and a soft teal drop." },
			"overlay": { "$type": "shadow", "$value": { "light": "0 8px 24px rgb(0 0 0 / 0.12)", "dark": "0 8px 24px rgb(0 0 0 / 0.5)" }, "$description": "Menus, popovers and modals only." }
		},
		"overlay": {
			"backdrop": { "$type": "color", "$value": { "light": "rgb(0 0 0 / 0.4)", "dark": "rgb(0 0 0 / 0.6)" }, "$description": "Behind modals." }
		},
		"duration": {
			"fast": { "$type": "duration", "$value": "120ms" },
			"base": { "$type": "duration", "$value": "180ms" }
		},
		"ease": {
			"out": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" }
		},
		"z-index": {
			"base": { "$type": "number", "$value": 0 },
			"sticky": { "$type": "number", "$value": 10 },
			"dropdown": { "$type": "number", "$value": 100 },
			"overlay": { "$type": "number", "$value": 1000 },
			"modal": { "$type": "number", "$value": 1010 },
			"toast": { "$type": "number", "$value": 1020 }
		},
		"breakpoint": {
			"sm": { "$type": "dimension", "$value": "600px" },
			"md": { "$type": "dimension", "$value": "782px", "$description": "wp-admin's." },
			"lg": { "$type": "dimension", "$value": "1080px" },
			"xl": { "$type": "dimension", "$value": "1440px" }
		},
		"size": {
			"content-max": { "$type": "dimension", "$value": "1200px" },
			"prose-max": { "$type": "dimension", "$value": "680px" }
		}

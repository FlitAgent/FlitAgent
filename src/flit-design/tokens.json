			"neutral-bg": { "$type": "color", "$value": { "light": "{primitive.color.warm-sunken}", "dark": "{primitive.color.neutral-800}" } },
			"neutral-icon": { "$type": "color", "$value": { "light": "{primitive.color.warm-ink-subtle}", "dark": "{primitive.color.neutral-300}" } }
		},
		"font": {
			"sans": { "$type": "fontFamily", "$value": "\"Inter\", system-ui, sans-serif" },
			"mono": { "$type": "fontFamily", "$value": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" },
			"mono-scale": { "$type": "dimension", "$value": "0.92em", "$description": "Mono next to sans." }
		},
		"font-weight": {
			"regular": { "$type": "fontWeight", "$value": 400 },
			"medium": { "$type": "fontWeight", "$value": 500 },
			"semibold": { "$type": "fontWeight", "$value": 600 }
		},
		"font-size": {
			"xs": { "$type": "dimension", "$value": "12px", "$description": "Badges, meta." },
			"sm": { "$type": "dimension", "$value": "13px", "$description": "wp-admin base, table cells." },
